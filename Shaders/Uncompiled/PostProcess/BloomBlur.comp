#version 450 core
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable

#define BindlessImageSet 1
#define GBufferUBOSet    2

#include "../../Globals/Bindless.h"
#include "../../Globals/Common.h"
#include "../../Globals/PushConstants.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants
{
    BloomPushConstants push;
};

// 5-tap Gaussian weights
const float weights[5] = float[](0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);

void main()
{
    ivec2 outputCoords = ivec2(gl_GlobalInvocationID.xy);
    if (outputCoords.x >= int(push.outputWidth) || outputCoords.y >= int(push.outputHeight))
        return;

    vec2 uv = (vec2(outputCoords) + 0.5) / vec2(push.outputWidth, push.outputHeight);
    vec2 offsetStep = (push.isVerticalPass != 0u) 
        ? vec2(0.0, 1.0 / float(push.outputHeight)) 
        : vec2(1.0 / float(push.outputWidth), 0.0);

    vec3 result = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv).rgb * weights[0];

    for (int i = 1; i < 5; ++i)
    {
        vec2 offset = offsetStep * float(i);
        result += texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + offset).rgb * weights[i];
        result += texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv - offset).rgb * weights[i];
    }

    imageStore(GlobalBindlessImages[nonuniformEXT(push.outputImageIdx)], outputCoords, vec4(result, 1.0));
}
