#version 450 core
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable

#define BindlessImageSet 1
#define GBufferUBOSet    2

#include "../../Globals/Bindless.h"
#include "../../Globals/Common.h"
#include "../../Globals/PushConstants.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants
{
    BloomPushConstants push;
};

void main()
{
    ivec2 outputCoords = ivec2(gl_GlobalInvocationID.xy);
    if (outputCoords.x >= int(push.outputWidth) || outputCoords.y >= int(push.outputHeight))
        return;

    vec2 uv = (vec2(outputCoords) + 0.5) / vec2(push.outputWidth, push.outputHeight);
    vec2 texelSize = 1.0 / vec2(push.width, push.height);
    float radius = push.filterRadius;

    // 9-tap tent filter upsampling using 4 bilinear samples
    vec3 A = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2(-1.0, -1.0) * texelSize * radius).rgb;
    vec3 B = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 1.0, -1.0) * texelSize * radius).rgb;
    vec3 C = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2(-1.0,  1.0) * texelSize * radius).rgb;
    vec3 D = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 1.0,  1.0) * texelSize * radius).rgb;

    vec3 E = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 0.0, -1.0) * texelSize * radius).rgb;
    vec3 F = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2(-1.0,  0.0) * texelSize * radius).rgb;
    vec3 G = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 1.0,  0.0) * texelSize * radius).rgb;
    vec3 H = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 0.0,  1.0) * texelSize * radius).rgb;

    vec3 I = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv).rgb;

    vec3 upsampledColor = (A + B + C + D) * (1.0 / 16.0) +
                         (E + F + G + H) * (2.0 / 16.0) +
                         I * (4.0 / 16.0);

    // Read current higher-resolution mip level color to additively blend
    vec3 currentMipColor = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTargetTexIdx)], uv).rgb;
    vec3 accumulated = currentMipColor + upsampledColor;

    if (push.useLensTexture != 0u)
    {
        vec3 lensDirt = texture(GlobalBindlessTextures[nonuniformEXT(push.lensTextureIdx)], uv).rgb;
        accumulated += accumulated * lensDirt * push.lensDirtIntensity;
    }

    if (push.useKarisAverage != 0u)
    {
        accumulated *= push.intensity;
    }

    imageStore(GlobalBindlessImages[nonuniformEXT(push.outputImageIdx)], outputCoords, vec4(accumulated, 1.0));
}
