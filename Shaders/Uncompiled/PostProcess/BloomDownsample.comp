#version 450 core
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable

#define BindlessImageSet 1
#define GBufferUBOSet    2

#include "../../Globals/Bindless.h"
#include "../../Globals/Common.h"
#include "../../Globals/PushConstants.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants
{
    BloomPushConstants push;
};

float Luminance(vec3 c)
{
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec3 Prefilter(vec3 c, float threshold)
{
    float brightness = max(c.r, max(c.g, c.b));
    float soft = brightness - threshold + 0.5;
    soft = clamp(soft, 0.0, 1.0);
    soft = soft * soft;
    float contribution = max(brightness - threshold, soft) / max(brightness, 0.00001);
    return c * contribution;
}

vec3 KarisBox(vec3 c0, vec3 c1, vec3 c2, vec3 c3)
{
    float w0 = 1.0 / (1.0 + Luminance(c0));
    float w1 = 1.0 / (1.0 + Luminance(c1));
    float w2 = 1.0 / (1.0 + Luminance(c2));
    float w3 = 1.0 / (1.0 + Luminance(c3));
    return (c0 * w0 + c1 * w1 + c2 * w2 + c3 * w3) / (w0 + w1 + w2 + w3 + 0.00001);
}

void main()
{
    ivec2 outputCoords = ivec2(gl_GlobalInvocationID.xy);
    if (outputCoords.x >= int(push.outputWidth) || outputCoords.y >= int(push.outputHeight))
        return;

    vec2 uv = (vec2(outputCoords) + 0.5) / vec2(push.outputWidth, push.outputHeight);
    vec2 texelSize = 1.0 / vec2(push.width, push.height);

    // Call of Duty: Advanced Warfare (Jorge Jimenez 2014) 13-Tap Downsample Filter
    // 5 bilinear sample boxes covering 13 texels in a 6x6 footprint
    vec3 A = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2(-1.0, -1.0) * texelSize).rgb;
    vec3 B = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 1.0, -1.0) * texelSize).rgb;
    vec3 C = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2(-1.0,  1.0) * texelSize).rgb;
    vec3 D = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 1.0,  1.0) * texelSize).rgb;

    vec3 E = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2(-2.0, -2.0) * texelSize).rgb;
    vec3 F = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 2.0, -2.0) * texelSize).rgb;
    vec3 G = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2(-2.0,  2.0) * texelSize).rgb;
    vec3 H = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 2.0,  2.0) * texelSize).rgb;

    vec3 I = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 0.0, -2.0) * texelSize).rgb;
    vec3 J = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2(-2.0,  0.0) * texelSize).rgb;
    vec3 K = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 2.0,  0.0) * texelSize).rgb;
    vec3 L = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 0.0,  2.0) * texelSize).rgb;

    vec3 M = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv).rgb;

    vec3 downsampledColor = vec3(0.0);

    if (push.useKarisAverage != 0u)
    {
        A = Prefilter(A, push.threshold);
        B = Prefilter(B, push.threshold);
        C = Prefilter(C, push.threshold);
        D = Prefilter(D, push.threshold);
        E = Prefilter(E, push.threshold);
        F = Prefilter(F, push.threshold);
        G = Prefilter(G, push.threshold);
        H = Prefilter(H, push.threshold);
        I = Prefilter(I, push.threshold);
        J = Prefilter(J, push.threshold);
        K = Prefilter(K, push.threshold);
        L = Prefilter(L, push.threshold);
        M = Prefilter(M, push.threshold);

        vec3 box0 = KarisBox(A, B, C, D);
        vec3 box1 = KarisBox(E, I, J, M);
        vec3 box2 = KarisBox(I, F, M, K);
        vec3 box3 = KarisBox(J, M, G, L);
        vec3 box4 = KarisBox(M, K, L, H);

        downsampledColor = box0 * 0.5 + (box1 + box2 + box3 + box4) * 0.125;
    }
    else
    {
        vec3 box0 = (A + B + C + D) * 0.25;
        vec3 box1 = (E + I + J + M) * 0.25;
        vec3 box2 = (I + F + M + K) * 0.25;
        vec3 box3 = (J + M + G + L) * 0.25;
        vec3 box4 = (M + K + L + H) * 0.25;

        downsampledColor = box0 * 0.5 + (box1 + box2 + box3 + box4) * 0.125;
    }

    imageStore(GlobalBindlessImages[nonuniformEXT(push.outputImageIdx)], outputCoords, vec4(downsampledColor, 1.0));
}
