#version 450 core
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable

#define BindlessImageSet 1
#define GBufferUBOSet    2

#include "../../Globals/Bindless.h"
#include "../../Globals/Common.h"
#include "../../Globals/PushConstants.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants
{
    BloomPushConstants push;
};

void main()
{
    ivec2 outputCoords = ivec2(gl_GlobalInvocationID.xy);
    if (outputCoords.x >= int(push.outputWidth) || outputCoords.y >= int(push.outputHeight))
        return;

    vec2 uv = (vec2(outputCoords) + 0.5) / vec2(push.outputWidth, push.outputHeight);

    // 4-tap box filter downsample from input texture
    vec2 texelSize = 1.0 / vec2(push.width, push.height);
    vec3 color = texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2(-0.5, -0.5) * texelSize).rgb;
    color += texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 0.5, -0.5) * texelSize).rgb;
    color += texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2(-0.5,  0.5) * texelSize).rgb;
    color += texture(GlobalBindlessTextures[nonuniformEXT(push.inputTexIdx)], uv + vec2( 0.5,  0.5) * texelSize).rgb;
    color *= 0.25;

    // Apply brightness thresholding
    vec3 brightColor = max(vec3(0.0), color - vec3(push.threshold));

    imageStore(GlobalBindlessImages[nonuniformEXT(push.outputImageIdx)], outputCoords, vec4(brightColor, 1.0));
}
