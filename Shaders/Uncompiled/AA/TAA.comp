#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_scalar_block_layout : enable

#define GBufferUBOSet 3
#include "../../Globals/Bindless.h"
#include "../../Globals/Common.h"
#include "../../Globals/Scene.h"
#include "../../Globals/GBuffer/GBufferSampling.h"
#include "../../Globals/PushConstants.h"
#include "../../Globals/Utils/ScreenSpace.h"

// TAA never upscales: scene color, depth, velocity and history share one resolution
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants
{
    TAAPushConstants data;
}
pushConstantsBlock;

#define pushConstants pushConstantsBlock.data

vec3 RGBToYCoCg(vec3 c)
{
    float y = dot(c, vec3(0.25f, 0.5f, 0.25f));
    float co = dot(c, vec3(0.5f, 0.0f, -0.5f));
    float cg = dot(c, vec3(-0.25f, 0.5f, -0.25f));
    return vec3(y, co, cg);
}

vec3 YCoCgToRGB(vec3 c)
{
    float y_minus_cg = c.x - c.z;
    return vec3(y_minus_cg + c.y, c.x + c.z, y_minus_cg - c.y);
}

// Filtering, clipping and blending run on tonemapped values so bright samples cannot dominate
vec3 Tonemap(vec3 c)
{
    float l = max(c.r, max(c.g, c.b));
    return c / (1.0f + l);
}

vec3 TonemapInverse(vec3 c_tm)
{
    float l_tm = max(c_tm.r, max(c_tm.g, c_tm.b));
    float l_tm_safe = min(l_tm, 1.0f - 1e-3f);
    vec3 c_norm = (l_tm > 0.0f) ? (c_tm * (l_tm_safe / l_tm)) : vec3(0.0f);
    vec3 c_hdr = c_norm / (1.0f - l_tm_safe);
    return clamp(c_hdr, vec3(0.0f), vec3(65500.0f));
}

// Playdead style: clip toward the box center instead of clamping per channel
vec3 ClipAABB(vec3 aabb_min, vec3 aabb_max, vec3 q)
{
    vec3 center = 0.5f * (aabb_max + aabb_min);
    vec3 extents = 0.5f * (aabb_max - aabb_min) + 1e-5f;
    vec3 offset = q - center;
    vec3 unit = abs(offset / extents);
    float maxUnit = max(unit.x, max(unit.y, unit.z));
    return maxUnit > 1.0f ? center + offset / maxUnit : q;
}

// 5-tap Catmull-Rom, relies on bilinear filtering of the history
vec3 SampleHistoryCatmullRom(vec2 uv, vec2 resolution)
{
    vec2 samplePosition = uv * resolution;
    vec2 texPos1 = floor(samplePosition - 0.5f) + 0.5f;
    vec2 f = samplePosition - texPos1;

    vec2 w0 = f * (-0.5f + f * (1.0f - 0.5f * f));
    vec2 w1 = 1.0f + f * f * (-2.5f + 1.5f * f);
    vec2 w2 = f * (0.5f + f * (2.0f - 1.5f * f));
    vec2 w3 = f * f * (-0.5f + 0.5f * f);

    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / w12;

    vec2 invResolution = 1.0f / resolution;
    vec2 texPos0 = (texPos1 - 1.0f) * invResolution;
    vec2 texPos3 = (texPos1 + 2.0f) * invResolution;
    vec2 texPos12 = (texPos1 + offset12) * invResolution;

    uint historyIdx = gbufferUBO.taaHistoryIdx;
    vec3 result = vec3(0.0f);
    result += SampleLinearClamp(historyIdx, vec2(texPos12.x, texPos0.y)).rgb * w12.x * w0.y;
    result += SampleLinearClamp(historyIdx, vec2(texPos0.x, texPos12.y)).rgb * w0.x * w12.y;
    result += SampleLinearClamp(historyIdx, vec2(texPos12.x, texPos12.y)).rgb * w12.x * w12.y;
    result += SampleLinearClamp(historyIdx, vec2(texPos3.x, texPos12.y)).rgb * w3.x * w12.y;
    result += SampleLinearClamp(historyIdx, vec2(texPos12.x, texPos3.y)).rgb * w12.x * w3.y;

    float weightSum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(result / max(weightSum, 1e-5f), vec3(0.0f));
}

// Gaussian fit of Blackman-Harris, distance in pixels
float BlackmanHarris(vec2 d)
{
    return exp(-2.29f * dot(d, d));
}

vec3 LoadSceneColor(ivec2 pixel)
{
    vec3 c = texelFetch(GlobalBindlessTextures[nonuniformEXT(gbufferUBO.sceneColorIdx)], pixel, 0).rgb;
    return any(isnan(c)) ? vec3(0.0f) : max(c, vec3(0.0f));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    vec2 resolution = ubo.renderResolution;
    if (pixel.x >= int(resolution.x) || pixel.y >= int(resolution.y))
        return;

    ivec2 maxPixel = ivec2(resolution) - 1;
    vec2 uv = (vec2(pixel) + 0.5f) / resolution;

    // Texel t holds the scene sample at t + 0.5 - jitter since rasterization shifted the image by +jitter
    vec2 jitter = ubo.jitterOffset;

    vec3 filtered = vec3(0.0f);
    float filteredWeight = 0.0f;
    vec3 m1 = vec3(0.0f);
    vec3 m2 = vec3(0.0f);
    vec3 crossMin = vec3(1e10f);
    vec3 crossMax = vec3(-1e10f);
    float closestDepth = -1.0f;
    ivec2 closestPixel = pixel;

    for (int dy = -1; dy <= 1; ++dy)
    {
        for (int dx = -1; dx <= 1; ++dx)
        {
            ivec2 tap = clamp(pixel + ivec2(dx, dy), ivec2(0), maxPixel);
            vec3 c = RGBToYCoCg(Tonemap(LoadSceneColor(tap)));

            // Reconstructs the unjittered sample at this pixel center
            float w = BlackmanHarris(vec2(dx, dy) - jitter);
            filtered += c * w;
            filteredWeight += w;

            m1 += c;
            m2 += c * c;
            // Cross shaped min/max keeps thin high contrast edges tight
            if (dx == 0 || dy == 0)
            {
                crossMin = min(crossMin, c);
                crossMax = max(crossMax, c);
            }

            // Reversed Z, larger is closer
            float z = texelFetch(GlobalBindlessTextures[nonuniformEXT(gbufferUBO.depthBufferIdx)], tap, 0).r;
            if (z > closestDepth)
            {
                closestDepth = z;
                closestPixel = tap;
            }
        }
    }

    vec3 current = filtered / filteredWeight;
    float alpha = texelFetch(GlobalBindlessTextures[nonuniformEXT(gbufferUBO.sceneColorIdx)], pixel, 0).a;

    // Velocity is current minus previous NDC (+y up), dilated to the closest surface
    vec2 velocityNdc =
        texelFetch(GlobalBindlessTextures[nonuniformEXT(gbufferUBO.gbufferVelocityIdx)], closestPixel, 0).rg;
    vec2 velocityUV = velocityNdc * vec2(0.5f, -0.5f);
    vec2 prevUV = uv - velocityUV;

    if (ubo.temporalReset != 0u || !IsUVInBounds(prevUV))
    {
        imageStore(GlobalBindlessImages[nonuniformEXT(gbufferUBO.taaOutputIdx)],
                   pixel,
                   vec4(TonemapInverse(YCoCgToRGB(current)), alpha));
        return;
    }

    vec3 history = RGBToYCoCg(Tonemap(SampleHistoryCatmullRom(prevUV, resolution)));

    float velocityPixels = length(velocityUV * resolution);
    float rejectionStart = pushConstants.velocityRejectionStart;
    float rejectionEnd = max(pushConstants.velocityRejectionEnd, rejectionStart + 1e-3f);
    float motion = clamp((velocityPixels - rejectionStart) / (rejectionEnd - rejectionStart), 0.0f, 1.0f);

    // Variance box, tighter while moving
    vec3 mean = m1 / 9.0f;
    vec3 sigma = sqrt(max(m2 / 9.0f - mean * mean, vec3(0.0f)));
    float gamma = mix(1.25f, 1.0f, motion);
    vec3 boxMin = max(mean - sigma * gamma, crossMin);
    vec3 boxMax = min(mean + sigma * gamma, crossMax);
    history = ClipAABB(min(boxMin, boxMax), max(boxMin, boxMax), history);

    float currentWeight = mix(0.05f, 0.125f, motion);
    vec3 result = mix(history, current, currentWeight);

    imageStore(GlobalBindlessImages[nonuniformEXT(gbufferUBO.taaOutputIdx)],
               pixel,
               vec4(TonemapInverse(max(YCoCgToRGB(result), vec3(0.0f))), alpha));
}
