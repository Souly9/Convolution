#version 460 core
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable

#define BindlessImageSet 0
#define GBufferUBOSet    3

#include "../../Globals/Bindless.h"
#include "../../Globals/GBuffer/GBufferSampling.h"
#include "../../Globals/PushConstants.h"
#include "../../Globals/Scene.h"

layout(push_constant) uniform RTCompositePushConstantsBlock
{
    RTCompositePushConstants pc;
};

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// View distance from reversed-Z depth (projection built with near and far swapped)
float ReversedDepthToViewDistance(float depth)
{
    return ubo.zNear * ubo.zFar / (depth * (ubo.zFar - ubo.zNear) + ubo.zNear);
}

void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 renderResolution = imageSize(GlobalBindlessImages[nonuniformEXT(gbufferUBO.sceneColorIdx)]);
    if (pixelCoord.x >= renderResolution.x || pixelCoord.y >= renderResolution.y)
        return;

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(renderResolution);

    // 1. Sample deferred lighting color using imageLoad to avoid write-hazard on the same storage image
    vec3 sceneColor = imageLoad(GlobalBindlessImages[nonuniformEXT(gbufferUBO.sceneColorIdx)], pixelCoord).rgb;

    // 2. Sample RT outputs via push-constant indices
    float currentAO = 1.0;
    if (pc.rtaoTexIdx != 0u)
        currentAO = SamplePointClamp(pc.rtaoTexIdx, uv).r;

    vec3 currentReflections = vec3(0.0);
    if (pc.rtReflectionsTexIdx != 0u)
        currentReflections = SamplePointClamp(pc.rtReflectionsTexIdx, uv).rgb;

    // 3. Temporal Reprojection and Accumulation (Reflections in RGB, RTAO in A)
    vec4 accumulated;

    vec2 velocity = SamplePointClamp(gbufferUBO.gbufferVelocityIdx, uv).rg;
    vec2 velocity_uv = velocity * vec2(0.5, -0.5);
    vec2 uv_prev = uv - velocity_uv;

    bool uv_prev_valid = uv_prev.x >= 0.0 && uv_prev.x <= 1.0 && uv_prev.y >= 0.0 && uv_prev.y <= 1.0;

    vec4 history = vec4(currentReflections, currentAO);
    if (uv_prev_valid)
    {
        ivec2 prevCoord = clamp(ivec2(uv_prev * vec2(renderResolution)), ivec2(0), renderResolution - 1);
        uint historyTexIdx = pc.historyAccumTexIdx != 0u ? pc.historyAccumTexIdx : pc.accumTexIdx;
        history = imageLoad(GlobalBindlessImages[nonuniformEXT(historyTexIdx)], prevCoord);

        // Compare view distances with the reprojected depth; raw reversed-Z hides disocclusions past a few meters
        float centerDepth = SamplePointClamp(gbufferUBO.depthBufferIdx, uv).r;
        float prevDepth = SamplePointClamp(gbufferUBO.lastFrameDepthIdx, uv_prev).r;
        vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0) - FrameJitterNdc();
        vec4 prevClip = ubo.clipToPrevClip * vec4(ndc, centerDepth, 1.0);
        float expectedDistance = ReversedDepthToViewDistance(prevClip.z / prevClip.w);
        float prevDistance = ReversedDepthToViewDistance(prevDepth);
        if (prevClip.w <= 0.0 || abs(expectedDistance - prevDistance) > 0.05 * expectedDistance)
        {
            history = vec4(currentReflections, currentAO);
        }
    }

    if (pc.resetHistory != 0u)
    {
        accumulated = vec4(currentReflections, currentAO);
    }
    else
    {
        accumulated.rgb = mix(history.rgb, currentReflections, pc.accumRate);
        accumulated.a = mix(history.a, currentAO, max(pc.accumRate, 0.05));
    }

    imageStore(GlobalBindlessImages[nonuniformEXT(pc.accumTexIdx)], pixelCoord, accumulated);

    // 4. Apply AO from temporal accumulation
    if (pc.rtaoTexIdx != 0u)
        sceneColor *= accumulated.a;

    // 5. Add reflections
    if (pc.rtReflectionsTexIdx != 0u)
        sceneColor += accumulated.rgb;

    imageStore(
        GlobalBindlessImages[nonuniformEXT(gbufferUBO.sceneColorIdx)], pixelCoord, vec4(sceneColor, 1.0));
}
