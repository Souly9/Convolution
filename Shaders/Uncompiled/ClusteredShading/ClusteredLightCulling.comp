#version 450
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable

#define SharedDataUBOSet   0
#define TileArraySet       1
#define ClusterGridSet     2
#define ViewSpaceLightsSet 3

#include "../../Globals/ClusterLightData.h"
#include "../../Globals/ClusteredShading.h"
#include "../../Globals/PushConstants.h"

#define WORKGROUP_SIZE 32
layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, scalar) uniform PushConstants
{
    ClusterPushConstants data;
}
pushConstantsBlock;

#define pc pushConstantsBlock.data

shared vec4 sharedLights[WORKGROUP_SIZE];
shared uint sharedLightIndices[WORKGROUP_SIZE];

bool sphereIntersectsAABB(vec3 center, float radius, vec3 aabbMin, vec3 aabbMax)
{
    vec3 closest = clamp(center, aabbMin, aabbMax);
    vec3 diff = center - closest;
    return dot(diff, diff) <= (radius * radius);
}

void main()
{
    uint clusterX = gl_WorkGroupID.x;
    uint clusterY = gl_WorkGroupID.y;
    uint clusterZ = gl_LocalInvocationIndex;

    bool isValidCluster =
        (clusterX < pc.clusterCount.x && clusterY < pc.clusterCount.y && clusterZ < pc.clusterCount.z);

    uint clusterIdx = clusterX + clusterY * pc.clusterCount.x + clusterZ * pc.clusterCount.x * pc.clusterCount.y;
    uint baseIndex = clusterIdx * MAX_LIGHTS_PER_CLUSTER;

    // Debug bypass
    bool disableCulling = (ubo.debugFlags & DEBUG_FLAG_DISABLE_CLUSTER_CULLING) != 0u;
    if (disableCulling)
    {
        if (isValidCluster)
        {
            uint totalLights = min(pc.numLights, MAX_SCENE_LIGHTS);
            uint count = min(totalLights, MAX_LIGHTS_PER_CLUSTER - 1);
            for (uint i = 0; i < count; ++i)
            {
                StoreClusterLightIndex(baseIndex, i, i);
            }
            StoreClusterLightOffsetAndCount(clusterIdx, baseIndex, totalLights);
        }
        return;
    }

    vec3 aabbMin = vec3(0.0);
    vec3 aabbMax = vec3(0.0);
    float clusterZMin = 0.0;
    float clusterZMax = 0.0;

    if (isValidCluster)
    {
        aabbMin = clusterGrid.clusters[clusterIdx].minBounds.xyz;
        aabbMax = clusterGrid.clusters[clusterIdx].maxBounds.xyz;
        clusterZMin = min(aabbMin.z, aabbMax.z);
        clusterZMax = max(aabbMin.z, aabbMax.z);
    }

    uint tileIdx = clusterX + clusterY * uint(pc.clusterCount.x);
    uint tileCount = min(viewSpaceLights.tileCounters[tileIdx], MAX_LIGHTS_PER_TILE);
    uint tileBase = tileIdx * MAX_LIGHTS_PER_TILE;

    uint visibleCount = 0;
    uint localLightIndices[MAX_LIGHTS_PER_CLUSTER];

    // Cooperatively load tile candidate lights in batches of WORKGROUP_SIZE
    for (uint batchOffset = 0; batchOffset < tileCount; batchOffset += WORKGROUP_SIZE)
    {
        // Parallel coalesced load from VRAM into on-chip shared memory
        uint lightIdxInBatch = batchOffset + gl_LocalInvocationIndex;
        if (lightIdxInBatch < tileCount)
        {
            uint globalLightIdx = viewSpaceLights.tileLightIndices[tileBase + lightIdxInBatch];
            sharedLights[gl_LocalInvocationIndex] = viewSpaceLights.lights[globalLightIdx];
            sharedLightIndices[gl_LocalInvocationIndex] = globalLightIdx;
        }
        barrier();

        // Evaluate batch in fast shared memory
        uint batchCount = min(tileCount - batchOffset, WORKGROUP_SIZE);
        if (isValidCluster)
        {
            for (uint i = 0; i < batchCount; ++i)
            {
                if (visibleCount >= MAX_LIGHTS_PER_CLUSTER - 1)
                    break;

                vec4 vsLight = sharedLights[i];
                float lZMin = vsLight.z - vsLight.w;
                float lZMax = vsLight.z + vsLight.w;

                // Fast Z reject
                if (lZMin > clusterZMax || lZMax < clusterZMin)
                    continue;

                // Fine AABB test
                float r = vsLight.w * 1.05;
                if (sphereIntersectsAABB(vsLight.xyz, r, aabbMin, aabbMax))
                {
                    localLightIndices[visibleCount] = sharedLightIndices[i];
                    visibleCount++;
                }
            }
        }
        barrier();
    }

    // Write final output to global memory
    if (isValidCluster)
    {
        for (uint i = 0; i < visibleCount; ++i)
        {
            StoreClusterLightIndex(baseIndex, i, localLightIndices[i]);
        }
        StoreClusterLightOffsetAndCount(clusterIdx, baseIndex, visibleCount);
    }
}
